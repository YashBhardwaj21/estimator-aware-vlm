+
+void MapPoint::SetDynamicState(DynamicLandmarkState state)
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    if(mbBad && state != PERMANENTLY_BAD)
+        return;
+    mDynamicState = state;
+    if(state == TEMPORARILY_EXCLUDED) {
+        mfSemanticWeight = 0.0001f;
+        mnConsecutiveInliers = 0;
+    } else if(state == REACTIVATED) {
+        mfSemanticWeight = 1.0f;
+    } else if(state == REACTIVATION_PENDING) {
+        mfSemanticWeight = 0.5f;
+    } else if(state == ACTIVE) {
+        mfSemanticWeight = 1.0f;
+        mnConsecutiveInliers = 0;
+    } else if(state == PERMANENTLY_BAD) {
+        mfSemanticWeight = 0.0f;
+        mnConsecutiveInliers = 0;
+        mbBad = true;
+    }
+}
+
+MapPoint::DynamicLandmarkState MapPoint::GetDynamicState() const
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    return mDynamicState;
+}
+
+void MapPoint::SetSemanticWeight(float w)
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    if(mDynamicState == PERMANENTLY_BAD) return;
+    if(w < 0.0f) w = 0.0f;
+    if(w > 1.0f) w = 1.0f;
+    mfSemanticWeight = w;
+}
+
+float MapPoint::GetSemanticWeight() const
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    if(mDynamicState == TEMPORARILY_EXCLUDED)
+        return 0.0001f;
+    if(mDynamicState == PERMANENTLY_BAD)
+        return 0.0f;
+    return mfSemanticWeight;
+}
+
+void MapPoint::RecordConsecutiveInlier()
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    mnConsecutiveInliers++;
+}
+
+void MapPoint::ResetConsecutiveInliers()
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    mnConsecutiveInliers = 0;
+}
+
+int MapPoint::GetConsecutiveInliers() const
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    return mnConsecutiveInliers;
+}
+
+void MapPoint::UpdateReactivation(float reproj_residual_chi2, float chi2_thresh)
+{
+    UpdateReactivationWithFrame(reproj_residual_chi2, chi2_thresh, 0);
+}
+
+void MapPoint::UpdateReactivationWithFrame(float reproj_residual_chi2, float chi2_thresh, long unsigned int frameId)
+{
+    unique_lock<mutex> lock(mMutexDynamic);
+    if(mbBad || mDynamicState == PERMANENTLY_BAD)
+        return;
+    if(frameId > 0 && frameId == mnLastFrameIdReactivation)
+        return;
+    if(frameId > 0)
+        mnLastFrameIdReactivation = frameId;
+
+    if(mDynamicState == TEMPORARILY_EXCLUDED) {
+        if(reproj_residual_chi2 <= chi2_thresh) {
+            mnConsecutiveInliers++;
+            if(mnConsecutiveInliers >= 3) {
+                mDynamicState = REACTIVATION_PENDING;
+                mfSemanticWeight = 0.5f;
+            }
+        } else {
+            mnConsecutiveInliers = 0;
+        }
+    } else if(mDynamicState == REACTIVATION_PENDING) {
+        if(reproj_residual_chi2 <= chi2_thresh) {
+            mnConsecutiveInliers++;
+            if(mnConsecutiveInliers >= 5) {
+                mDynamicState = REACTIVATED;
+                mfSemanticWeight = 1.0f;
+            }
+        } else {
+            mDynamicState = TEMPORARILY_EXCLUDED;
+            mfSemanticWeight = 0.0001f;
+            mnConsecutiveInliers = 0;
+        }
+    }
+}
+
 } //namespace ORB_SLAM
