# ==============================================================================
# Gitignore for Vision-Language Model (VLM) Dynamic 3D Scene Graph Repository
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
myenv/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
tests/_test_run_tmp/
tests/accessible_tmp/
tests/basetemp_*/
tests/pytest_basetemp/
tests/test_tmp_*/
scratch/
report/
*.log

# Large Neural Network Weights & Checkpoints (>20MB - 250MB+)
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.tflite
models/

# Sensor Recordings, Raw Captures, ROS 2 Bags & Video Files
*.db3
*.bag
*.mkv
*.mp4
*.avi
*.pcap

# 3D Point Clouds, Scans & Meshes
*.ply
*.pcd
*.las

# Data Folders (Raw recordings, processed runs, crops & local semantic mappings)
data/
assignment/data/

# Historical Archives & Compressed Bundles
archive/
outputs_historical_archive/
*.part
*.zip
*.tar
*.tar.gz

# Generated Outputs & Run Artifacts
outputs/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini