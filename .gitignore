# ==============================================================================
# Gitignore for Vision-Language Model (VLM) Dynamic 3D Scene Graph Repository
# ==============================================================================

# Local Scratchpad, Experiments & Historical Archives (Strictly Local)
scratch/
archive/
outputs_historical_archive/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions, packaging & distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
myenv/

# Testing, Caches, Coverage & Linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
tests/_test_run_tmp/
tests/accessible_tmp/
tests/basetemp_*/
tests/pytest_basetemp/
tests/test_tmp_*/
report/
*.log

# Matplotlib & Local Rendering Caches
.matplotlib/
outputs/.matplotlib/

# Deep Learning Frameworks & Training Runs (Ultralytics, YOLO)
runs/
*.cache

# Large Neural Network Weights & Checkpoints (>20MB - 250MB+)
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.tflite
models/

# Sensor Recordings, Raw Captures, ROS 2 Bags & Video Files
*.db3
*.bag
*.bag.active
*.mkv
*.mp4
*.avi
*.pcap
*.rec

# 3D Point Clouds, Scans & Meshes
*.ply
*.pcd
*.las

# Data Folders (Raw recordings, processed runs, crops & local semantic mappings)
data/
assignment/data/

# Compressed Bundles & Partials
*.part
*.zip
*.tar
*.tar.gz

# Generated Outputs & Run Artifacts
outputs/

# Temporary, Backup & Swap Files
*.tmp
*.temp
*.bak
*.orig
*~
*.swp
*.swo

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IDE & Editor Configurations
.vscode/
.idea/

# Operating System Files
.DS_Store
[Tt]humbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
*.stackdump

# Agent Local Skills & Tools
.agents/
