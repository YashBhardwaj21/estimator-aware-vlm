# Python & runtime caches
__pycache__/
*.pyc
.cache/
*.egg-info/
*.dist-info/
build/
dist/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environment & editor
.venv/
.vscode/

# Local scratchpad & logs
scratch/
*.log
!results/baselines/**/*.log

# Archived historical materials
archive/

# Test cache
.pytest_cache/
tests/_test_run_tmp/

# Model checkpoints
models/
*.pt
*.bin
*.gguf

# Raw sensor data & point clouds (preserve dataset documentation)
/data/*
!/data/README.md
*.bag
*.ply
!results/baselines/**/*.ply
*.pcd

# Runtime execution outputs (preserve historical paper benchmark run)
/outputs/*
!/outputs/benchmark_runs/paper_benchmark_20261019_130902/

# Operating system files
Thumbs.db
.DS_Store
desktop.ini


# Intermediate mask image renders and generated visual crops
masked_rgb/
masked_depth/
**/crops/
**/.checkpoints/

# Large per-frame observation dumps (>50MB)
tracking_observations.jsonl
